# Base44 development defaults — placeholders so the app boots without credentials.
# Real values are delivered via /run/base44/app.env and override these.

VITE_APP_NAME=metronic-tailwind-react
VITE_APP_VERSION=9.2.6

# Auth backend: "local" (localStorage, no external services) or "supabase".
VITE_AUTH_MODE=local

# Supabase placeholders — valid URL format so createClient() does not throw.
# Auth/login will NOT work until real values are supplied.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key
VITE_SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
